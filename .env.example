# RailTrack India - Environment Configuration Example

# Project Info
PROJECT_NAME="RailTrack India - IR Passenger Information System"
VERSION="1.0.0"

# Database Configuration
# Local SQLite default (zero configuration needed):
DATABASE_URL="sqlite:///./railtracker.db"
# Or PostgreSQL for production/Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railtracker"

# Security & Authentication
SECRET_KEY="railway-super-secret-key-cris-railtel-2026-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Pre-Seeded Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@railtrack.gov.in"
ADMIN_PASSWORD="RailAdmin@2026"

# Live Tracking Provider Architecture
# Options: 'mock' (CRIS NTES simulation feed), 'api' (external live gateway), 'null' (strictly timetable only)
TRACKING_PROVIDER="mock"

# External API Gateway (when TRACKING_PROVIDER="api")
EXTERNAL_API_URL="https://api.indianrailways.gov.in/ntes/v1"
EXTERNAL_API_KEY=""

# Server Ports
PORT=8000
FRONTEND_PORT=5173
